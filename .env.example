# Pinecone index deployment. Keep actual secrets in .env, never in this file.
PINECONE_API_KEY=
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_INDEX_NAME=swv2
PINECONE_NAMESPACE=stories

# Pinecone hosted inference defaults.
DENSE_EMBEDDING_MODEL=llama-text-embed-v2
DENSE_EMBEDDING_DIMENSION=1024
SPARSE_EMBEDDING_MODEL=pinecone-sparse-english-v0

CHUNK_TARGET_TOKENS=550
CHUNK_MAX_TOKENS=700
CHUNK_OVERLAP_TOKENS=75
EMBED_BATCH_SIZE=64
UPSERT_BATCH_SIZE=100

# Natural-language story recommendation service.
GROQ_API_KEY=
GROQ_ANALYSIS_MODEL=openai/gpt-oss-20b
GROQ_WRITING_MODEL=openai/gpt-oss-20b
PINECONE_RERANK_MODEL=bge-reranker-v2-m3
SEARCH_PORT=8000
SEARCH_TIMEOUT_SECONDS=2.5
DENSE_TOP_K=50
SPARSE_TOP_K=50
RERANK_CANDIDATE_COUNT=20
RRF_K=60
